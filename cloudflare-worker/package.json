{
  "name": "edgepanel-worker",
  "version": "1.0.0",
  "description": "Serverless proxy configuration & subscription management panel running on Cloudflare Workers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute edgepanel-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute edgepanel-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
